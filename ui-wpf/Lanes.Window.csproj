<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Lanes.Window.exe: the mixer, the quick mixer (dash-dash-flyout), Settings
    (dash-dash-settings) and the new-app notice (dash-dash-arrival).

    A pure client of the local API, in its own process - see
    docs/architecture.md for why that boundary is a process and not a rule.
    Nothing here talks to Windows audio; everything goes through 127.0.0.1.

    Self-contained and single-file, so there is no runtime to install. That
    costs about 60MB on disk: a deliberate trade. The core stays Rust and
    small, and the audio path - the only place latency matters - is untouched.
    docs/window.md describes how the window is put together.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <AssemblyName>Lanes.Window</AssemblyName>
    <Version>1.0.0</Version>
    <!-- Keep the product version exactly "1.0.0": without this, a build from a
         git checkout appends "+<commit>", and signed releases need the same
         version attributes on every file. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Lanes</Product>
    <Description>Per-application audio channels for Windows - the mixer window</Description>
    <Copyright>Copyright (C) 2026 MAYBE-33. Licensed under the GPL, version 3 or later.</Copyright>
    <!-- Not "Lanes.Window": that would collide with System.Windows.Window
         in every file that opens one. -->
    <RootNamespace>Lanes.Ui</RootNamespace>

    <!-- Per-monitor DPI v2, declared rather than left to a default: the mixer
         is used across displays of different scaling. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- The executable's own icon, as Explorer and the taskbar read it.
         The .ico is generated by tools/make_icon.ps1 and committed, so a
         normal build never needs the script to have been run. -->
    <ApplicationIcon>../assets/icon.ico</ApplicationIcon>

    <!-- Warnings are not optional here: "compiles with a warning, misbehaves at
         runtime" is the most expensive kind of bug to find later. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- The same file again, this time as a WPF resource, which is what
         Window.Icon needs for the title bar and Alt+Tab. ApplicationIcon above
         covers Explorer; the two are separate mechanisms reading the same
         picture. -->
    <Resource Include="../assets/icon.ico" Link="icon.ico" />
  </ItemGroup>

</Project>
