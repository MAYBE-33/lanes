<!--
    The visual direction, called "Quiet": no panels, whitespace grouping,
    type-led hierarchy, and a 1px border on each channel strip. docs/window.md
    describes it. Accents are muted, share chroma and lightness, and appear
    only on the name bar and the meter fill - never on text, icons or borders.

    Every colour lives here, or in its light twin ThemeLight.xaml, which is
    merged after this file when the light theme is on and must define every
    colour this one does. A hex literal anywhere else is a bug waiting to
    become an inconsistency.

    Colours used INSIDE this file are DynamicResource, not StaticResource. A
    static reference is resolved within the dictionary it is written in, so it
    would find the dark value here even with the light palette merged over it.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Base palette -->
    <Color x:Key="GroundColor">#FF131315</Color>
    <SolidColorBrush x:Key="Ground" Color="{StaticResource GroundColor}"/>
    <SolidColorBrush x:Key="Raised" Color="#FF1A1A1D"/>
    <SolidColorBrush x:Key="Line" Color="#FF222227"/>
    <SolidColorBrush x:Key="LineStrong" Color="#FF25252A"/>
    <SolidColorBrush x:Key="Track" Color="#FF202024"/>

    <!--
        A card is a strip or the mix panel: a whisper above the ground, not a
        panel. The direction is "group with whitespace, not boxes", and this is
        two percent of lightness - just enough that a strip reads as one object
        with a border round it rather than as a border drawn on the ground.
    -->
    <SolidColorBrush x:Key="Card" Color="#FF161619"/>
    <SolidColorBrush x:Key="Hover" Color="#FF202026"/>

    <!--
        Application chips. Higher contrast than the cards they sit on, because
        a chip is a thing you pick up and drag: it has to read as an object
        with an edge, and its text has to be legible whether or not the
        application happens to be making a sound right now.
    -->
    <SolidColorBrush x:Key="Chip" Color="#FF25252C"/>
    <SolidColorBrush x:Key="ChipLine" Color="#FF32323B"/>
    <SolidColorBrush x:Key="ChipLineHot" Color="#FF45454F"/>

    <!-- A detent nobody is pointing at. Above the track, below Raised, so the
         markers read as part of the fader rather than as separate furniture. -->
    <SolidColorBrush x:Key="DetentIdle" Color="#FF2A2A31"/>

    <!--
        The fader cap, lit from above like a real one - and DARK.

        It was near-white, which put the brightest object in the window on a
        control that is only a handle. Worse, the detent the channel sits on
        takes the channel's colour, and the cap is always exactly on that
        detent, so a bright pill and a coloured one were permanently stuck
        together and read as a single spoon-shaped blob.

        A dark cap with the channel's colour across it reads as the handle
        docked on a lit mark, which is what is actually happening.
    -->
    <Color x:Key="CapTopColor">#FF4C4C58</Color>
    <Color x:Key="CapBottomColor">#FF313139</Color>
    <Color x:Key="CapTopMutedColor">#FF34343A</Color>
    <Color x:Key="CapBottomMutedColor">#FF26262B</Color>
    <SolidColorBrush x:Key="CapEdge" Color="#FF5E5E6C"/>

    <SolidColorBrush x:Key="Text" Color="#FFEDEDF0"/>
    <SolidColorBrush x:Key="TextDim" Color="#FF85858D"/>
    <SolidColorBrush x:Key="TextFaint" Color="#FF6E6E75"/>
    <SolidColorBrush x:Key="TextGhost" Color="#FF5E5E66"/>

    <SolidColorBrush x:Key="Warn" Color="#FFE0A84E"/>
    <SolidColorBrush x:Key="WarnGround" Color="#FF2B2315"/>
    <SolidColorBrush x:Key="MutedGrey" Color="#FF44444B"/>
    <SolidColorBrush x:Key="DotIdle" Color="#FF55555D"/>

    <SolidColorBrush x:Key="PopupGround" Color="#FF18181C"/>

    <!-- How dark a popup's drop shadow is. Per theme, because the same shadow
         that separates a popup from near-black is a smudge on near-white. -->
    <sys:Double x:Key="ShadowOpacity">0.62</sys:Double>

    <!--
        Per-channel accents. Looked up by channel id at runtime, with
        AccentFallback for a channel the user has added.

        AccentFallback was a neutral grey, which made an added channel look
        like a second Master. Seven channels at most means there is only ever
        one added channel, so the fallback is simply a seventh colour: a muted
        teal, a hue family none of the six use, at the same chroma and
        lightness so it does not shout louder than its neighbours.
    -->
    <SolidColorBrush x:Key="Accent.master" Color="#FFB9BCC4"/>
    <SolidColorBrush x:Key="Accent.game"   Color="#FFD97757"/>
    <SolidColorBrush x:Key="Accent.chat"   Color="#FF6BA8C9"/>
    <SolidColorBrush x:Key="Accent.media"  Color="#FF7FB069"/>
    <SolidColorBrush x:Key="Accent.aux"    Color="#FFB48EAD"/>
    <SolidColorBrush x:Key="Accent.mic"    Color="#FFD8A657"/>
    <SolidColorBrush x:Key="AccentFallback" Color="#FF5DB3A5"/>

    <!--
        Manrope is the direction's typeface. It is not a Windows font, so this
        falls through to Segoe UI Variable rather than letting WPF pick
        something arbitrary. The hierarchy is carried by size and weight, which
        survives the substitution.
    -->
    <FontFamily x:Key="UiFont">Manrope, Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- Type scale. Channel names are the loudest text on screen. -->
    <sys:Double x:Key="SizeChannel">16</sys:Double>
    <sys:Double x:Key="SizeBody">13</sys:Double>
    <sys:Double x:Key="SizeSmall">12</sys:Double>
    <sys:Double x:Key="SizeTiny">11</sys:Double>

    <!-- Text defaults, so nothing has to restate the font. -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="{StaticResource SizeSmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!--
        A flat, quiet button. WPF's default has a gradient, a border and a blue
        hover that belong to a different application entirely, so the template
        is replaced rather than restyled.
    -->
    <Style x:Key="QuietButton" TargetType="ButtonBase">
        <Setter Property="Background" Value="{DynamicResource Raised}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="{StaticResource SizeSmall}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Shell"
                            Background="{TemplateBinding Background}"
                            CornerRadius="9"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{DynamicResource LineStrong}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
